			"kinds": [
				"node",
				"waypoint",
				"link",
				"zone",
				"group"
			],
			"grammar": [
				{
					"file": "planner/validate.js",
					"name": "ID",
					"others": [
						"diagram",
						"template"
					],
					"rest": "-[0-9a-f]{6}$"
				}
			]
		},
		"L8": {
			"dir": "lab",
			"budget": 4
		},
		"L9": {
